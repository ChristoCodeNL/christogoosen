---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Arrow from '../components/Arrow.astro';
import ContentCard from '../components/ContentCard.astro';
import Base from '../layouts/Base.astro';
import heroImage from '../assets/hero-circuit.png';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
const books = (await getCollection('books')).filter((b) => !b.data.draft);

type FeedItem = {
  href: string;
  category: string;
  title: string;
  description: string;
  meta?: string;
  cta: string;
  image?: ImageMetadata;
  date: Date;
};

const feed: FeedItem[] = [
  ...posts.map((p) => ({
    href: `/essays/${p.id}/`,
    category: p.data.category,
    title: p.data.title,
    description: p.data.description,
    cta: p.data.category === 'Essay' ? 'Read essay' : 'Read note',
    image: p.data.heroImage,
    date: p.data.pubDate,
  })),
  ...books.map((b) => ({
    href: `/books/${b.id}/`,
    category: 'Book review',
    title: b.data.title,
    description: b.data.description,
    meta: b.data.author,
    cta: 'Read review',
    image: b.data.cover,
    date: b.data.pubDate,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const recent = feed.slice(0, 5);
const latestEssay = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
---
<Base title={`${SITE_TITLE} — Product leader, systems thinker`} description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <Image src={heroImage} alt="" width={1672} height={941} loading="eager" fetchpriority="high" />
      <div class="hero-scrim"></div>
    </div>
    <div class="hero-copy">
      <p class="t-eyebrow">Engineer mind. Human focus.</p>
      <h1 class="t-hero">
        Product leader.<br />
        Systems thinker.<br />
        Clear by design<span class="dot">.</span>
      </h1>
      <p class="t-intro lede">{SITE_DESCRIPTION}</p>
      {latestEssay ? (
        <a class="btn" href={`/essays/${latestEssay.id}/`}>Latest essay <Arrow /></a>
      ) : (
        <a class="btn" href="/essays">All essays <Arrow /></a>
      )}
    </div>
  </section>

  <section class="desk shell">
    <div class="section-head">
      <h2 class="t-section-label">Recent from the desk</h2>
      <a class="link" href="/essays"><span>View all</span> <Arrow /></a>
    </div>

    {recent.length > 0 ? (
      <div class="grid">
        {recent.map((item) => (
          <ContentCard
            href={item.href}
            category={item.category}
            title={item.title}
            description={item.description}
            meta={item.meta}
            cta={item.cta}
            image={item.image}
          />
        ))}
      </div>
    ) : (
      <p class="t-card-desc empty">Nothing published yet. The first essay lands soon.</p>
    )}
  </section>
</Base>

<style>
  /* The image is a full-bleed layer; a left-to-right white scrim fades it out
     under the headline so the copy sits on clean white and the chip stays
     legible on the right. */
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--card);
    border-bottom: 1px solid var(--divider);
    overflow: hidden;
    min-height: clamp(420px, 44vw, 560px);
    display: grid;
    align-items: center;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #eef0f4;
  }

  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The chip sits right of centre in the source, so anchor there: the crop
       eats the empty left half rather than the subject. */
    object-position: 72% 50%;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      #fff 0%,
      #fff 26%,
      rgba(255, 255, 255, 0.94) 40%,
      rgba(255, 255, 255, 0.6) 55%,
      rgba(255, 255, 255, 0) 72%
    );
  }

  .hero-copy {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    width: 100%;
    max-width: var(--shell);
    margin-inline: auto;
    padding: var(--s-8) var(--gutter);
  }

  .hero-copy > * { max-width: 42ch; }
  .dot { color: var(--blue); }

  .desk { padding-block: var(--s-7) var(--s-8); }

  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }

  .grid > :global(*) { flex: 1 1 200px; max-width: 236px; }

  .empty { color: var(--grey); }


  /* Below this width there is not enough room to overlay: the chip collides
     with the body copy. Stack instead, copy first, image as its own block. */
  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow: visible;
    }

    .hero-copy { order: 1; padding: var(--s-7) var(--gutter) var(--s-6); }

    .hero-media {
      order: 2;
      position: relative;
      inset: auto;
      z-index: 0;
      width: 100%;
      aspect-ratio: 16 / 10;
      overflow: hidden;
    }

    .hero-media :global(img) { object-position: 72% 50%; }

    .hero-scrim { display: none; }
  }

  @media (max-width: 720px) {
    .grid { gap: 0; }
    .grid > :global(*) { flex: 1 1 100%; max-width: none; border-radius: 0; margin-top: -1px; }
  }
</style>
