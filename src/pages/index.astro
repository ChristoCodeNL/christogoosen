---
import { getCollection } from 'astro:content';
import Arrow from '../components/Arrow.astro';
import ContentCard from '../components/ContentCard.astro';
import HeroArt from '../components/HeroArt.astro';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
const books = (await getCollection('books')).filter((b) => !b.data.draft);

type FeedItem = {
  href: string;
  category: string;
  title: string;
  description: string;
  meta?: string;
  cta: string;
  image?: ImageMetadata;
  date: Date;
};

const feed: FeedItem[] = [
  ...posts.map((p) => ({
    href: `/essays/${p.id}/`,
    category: p.data.category,
    title: p.data.title,
    description: p.data.description,
    cta: p.data.category === 'Essay' ? 'Read essay' : 'Read note',
    image: p.data.heroImage,
    date: p.data.pubDate,
  })),
  ...books.map((b) => ({
    href: `/books/${b.id}/`,
    category: 'Book review',
    title: b.data.title,
    description: b.data.description,
    meta: b.data.author,
    cta: 'Read review',
    image: b.data.cover,
    date: b.data.pubDate,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const recent = feed.slice(0, 5);
const latestEssay = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
---
<Base title={`${SITE_TITLE} — Product leader, systems thinker`} description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="t-eyebrow">Engineer mind. Human focus.</p>
        <h1 class="t-hero">
          Product leader.<br />
          Systems thinker.<br />
          Clear by design<span class="dot">.</span>
        </h1>
        <p class="t-intro lede">{SITE_DESCRIPTION}</p>
        {latestEssay ? (
          <a class="btn" href={`/essays/${latestEssay.id}/`}>Latest essay <Arrow /></a>
        ) : (
          <a class="btn" href="/essays">All essays <Arrow /></a>
        )}
      </div>
      <div class="hero-media">
        <HeroArt label="Light falling through a concrete oculus" />
      </div>
    </div>
  </section>

  <section class="desk shell">
    <div class="section-head">
      <h2 class="t-section-label">Recent from the desk</h2>
      <a class="link" href="/essays"><span>View all</span> <Arrow /></a>
    </div>

    {recent.length > 0 ? (
      <div class="grid">
        {recent.map((item) => (
          <ContentCard
            href={item.href}
            category={item.category}
            title={item.title}
            description={item.description}
            meta={item.meta}
            cta={item.cta}
            image={item.image}
          />
        ))}
      </div>
    ) : (
      <p class="t-card-desc empty">Nothing published yet. The first essay lands soon.</p>
    )}
  </section>
</Base>

<style>
  .hero {
    background: var(--card);
    border-bottom: 1px solid var(--divider);
    padding-left: max(var(--gutter), calc((100% - var(--shell)) / 2 + var(--gutter)));
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    align-items: center;
    gap: var(--s-8);
  }

  .hero-copy {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    padding-block: var(--s-9);
  }

  .hero-copy .lede { max-width: 42ch; }
  .dot { color: var(--blue); }

  .hero-media {
    align-self: stretch;
    min-height: 420px;
    display: grid;
  }

  .desk { padding-block: var(--s-7) var(--s-8); }

  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }

  .grid > :global(*) { flex: 1 1 200px; max-width: 236px; }

  .empty { color: var(--grey); }


  @media (max-width: 980px) {
    .hero { padding-right: var(--gutter); }
    .hero-grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .hero-copy { padding-block: var(--s-7) 0; }
    .hero-media { min-height: 260px; margin-bottom: var(--s-7); }
  }

  @media (max-width: 720px) {
    .grid { gap: 0; }
    .grid > :global(*) { flex: 1 1 100%; max-width: none; border-radius: 0; margin-top: -1px; }
  }
</style>
