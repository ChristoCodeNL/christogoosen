---
import { NAV, SITE_TITLE } from '../consts';

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---
<header class="site-header">
  <div class="shell bar">
    <a href="/" class="t-wordmark mark">{SITE_TITLE}</a>

    <nav class="nav" aria-label="Primary">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={['t-nav', 'nav-link', { 'is-active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="sr-only">Open menu</span>
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Primary" hidden>
    {NAV.map((item) => (
      <a
        href={item.href}
        class:list={['t-nav', 'mobile-link', { 'is-active': isActive(item.href) }]}
        aria-current={isActive(item.href) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.getElementById('mobile-nav');
  const label = toggle?.querySelector('.sr-only');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
    if (label) label.textContent = open ? 'Open menu' : 'Close menu';
  });
</script>

<style>
  .site-header {
    background: var(--card);
    border-bottom: 1px solid var(--divider);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 64px;
  }

  .mark { text-decoration: none; }
  .mark:hover { color: var(--blue); }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--s-7);
  }

  .nav-link {
    color: var(--ink);
    position: relative;
    padding-block: 22px;
  }

  .nav-link:hover { color: var(--blue); }

  .nav-link.is-active { color: var(--blue); }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    height: 2px;
    background: var(--blue);
  }

  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 10px;
    margin-right: -10px;
    cursor: pointer;
    color: var(--ink);
  }

  .bars { display: grid; gap: 4px; }
  .bars i { display: block; width: 20px; height: 1.5px; background: currentColor; }

  .mobile-nav[hidden] { display: none; }

  .mobile-nav {
    display: grid;
    border-top: 1px solid var(--divider);
    padding: var(--s-2) var(--gutter) var(--s-4);
  }

  .mobile-link {
    color: var(--ink);
    padding: 14px 0;
    border-bottom: 1px solid var(--divider);
  }
  .mobile-link:last-child { border-bottom: 0; }
  .mobile-link.is-active { color: var(--blue); }

  @media (max-width: 860px) {
    .nav { display: none; }
    .menu-toggle { display: block; }
  }

  @media (min-width: 861px) {
    .mobile-nav { display: none; }
  }
</style>
