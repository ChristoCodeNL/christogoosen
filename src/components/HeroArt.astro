---
// Stand-in for the architectural hero photograph in the style guide.
// Vector, so it costs nothing and carries no licensing question.
// Swap it for a real image by passing one into the hero slot on each page.
interface Props {
  label?: string;
}
const { label = '' } = Astro.props;
const id = Math.random().toString(36).slice(2, 8);
---
<div class="hero-art" role="img" aria-label={label}>
  <svg viewBox="0 0 900 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id={`shell-${id}`} x1="0" y1="0" x2="0.6" y2="1">
        <stop offset="0%" stop-color="#f2f2f4" />
        <stop offset="100%" stop-color="#c9cbd2" />
      </linearGradient>
      <linearGradient id={`under-${id}`} x1="0.2" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#9a9da6" />
        <stop offset="100%" stop-color="#6f727b" />
      </linearGradient>
      <radialGradient id={`light-${id}`} cx="0.45" cy="0.35" r="0.75">
        <stop offset="0%" stop-color="#ffffff" />
        <stop offset="60%" stop-color="#e6ecf7" />
        <stop offset="100%" stop-color="#cdd8ee" />
      </radialGradient>
    </defs>

    <rect width="900" height="460" fill="#e4e5e9" />

    <!-- outer shell -->
    <path d="M900 0 H240 C120 90 60 250 130 460 H900 Z" fill={`url(#shell-${id})`} />

    <!-- recessed ring -->
    <ellipse cx="560" cy="235" rx="300" ry="180" fill={`url(#under-${id})`} opacity="0.85" />
    <ellipse cx="548" cy="245" rx="248" ry="142" fill="#4e515a" opacity="0.55" />

    <!-- oculus -->
    <ellipse cx="572" cy="222" rx="196" ry="106" fill={`url(#light-${id})`} />

    <!-- light spill across the floor -->
    <path d="M300 460 C 380 340 520 320 660 360 L 720 460 Z" fill="#ffffff" opacity="0.35" />

    <!-- hairline construction lines -->
    <path d="M240 0 C 120 90 60 250 130 460" fill="none" stroke="#ffffff" stroke-opacity="0.5" />
    <ellipse cx="572" cy="222" rx="196" ry="106" fill="none" stroke="#ffffff" stroke-opacity="0.35" />
  </svg>
</div>

<style>
  .hero-art { width: 100%; height: 100%; background: var(--divider); }
  .hero-art svg { width: 100%; height: 100%; display: block; }
</style>
